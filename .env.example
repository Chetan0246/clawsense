# =============================================================================
# ClawSense environment configuration — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# =============================================================================

# ---------------------------------------------------------------------------
# Application mode
# ---------------------------------------------------------------------------
# simulation -> deterministic simulated device + simulated agent (no hardware)
# hardware   -> real ESP32-S3 telemetry/commands over the configured transport
CLAWSENSE_APP_MODE=simulation

# ---------------------------------------------------------------------------
# Backend host/port and database
# ---------------------------------------------------------------------------
CLAWSENSE_HOST=0.0.0.0
CLAWSENSE_PORT=8000
CLAWSENSE_DB_PATH=./data/clawsense.sqlite3

# ---------------------------------------------------------------------------
# Agent / LLM provider
# ---------------------------------------------------------------------------
# provider: simulated | espclaw
CLAWSENSE_AGENT_PROVIDER=simulated
CLAWSENSE_AGENT_TIMEOUT_SECONDS=10
# ESPClaw integration endpoint. Leave blank to keep the adapter disabled.
CLAWSENSE_ESPCLAW_ENDPOINT=
# API key for the configured LLM provider. Backend-only; NEVER expose to the browser.
CLAWSENSE_LLM_API_KEY=
CLAWSENSE_LLM_MODEL=

# ---------------------------------------------------------------------------
# ESP32 device communication
# ---------------------------------------------------------------------------
# transport: simulated | http
CLAWSENSE_DEVICE_TRANSPORT=simulated
CLAWSENSE_DEVICE_BASE_URL=http://192.168.0.50
CLAWSENSE_DEVICE_ID=esp32s3-clawsense-01
CLAWSENSE_DEVICE_COMMAND_TIMEOUT_SECONDS=5
CLAWSENSE_DEVICE_RETRY_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Timeouts / health
# ---------------------------------------------------------------------------
CLAWSENSE_DEGRADED_TIMEOUT_SECONDS=15
CLAWSENSE_OFFLINE_TIMEOUT_SECONDS=45
CLAWSENSE_CONTEXT_MAX_AGE_SECONDS=30

# ---------------------------------------------------------------------------
# Sensor thresholds (used by the event engine and local fallback rules)
# ---------------------------------------------------------------------------
CLAWSENSE_TEMP_HIGH_C=35.0
CLAWSENSE_TEMP_LOW_C=5.0
CLAWSENSE_HUMIDITY_HIGH_PERCENT=80.0

# ---------------------------------------------------------------------------
# Safety: actuator allow-list, ranges, cooldowns
# ---------------------------------------------------------------------------
CLAWSENSE_SERVO_MIN_DEGREES=0
CLAWSENSE_SERVO_MAX_DEGREES=180
CLAWSENSE_BUZZER_MAX_MS=2000
CLAWSENSE_ACTION_COOLDOWN_SECONDS=3
CLAWSENSE_RATE_LIMIT_MAX=6
CLAWSENSE_RATE_LIMIT_WINDOW_SECONDS=30
# Comma-separated allow-list. Do not add unknown actions.
CLAWSENSE_ALLOWED_ACTIONS=servo_move,buzzer_beep,set_status_led,no_op
